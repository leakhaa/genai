# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration (SQLite for testing)
DATABASE_URL=sqlite:///wms_automation.db

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@company.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=16777216

# Warehouse Email Configuration
SAP_TEAM_EMAIL=sap-team@company.com
WAREHOUSE_MANAGER_EMAIL=warehouse-manager@company.com
IT_SUPPORT_EMAIL=it-support@company.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/wms_automation.log